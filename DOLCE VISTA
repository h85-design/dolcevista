function val(id){ return document.getElementById(id).value.trim(); }

function problems(){
  var p = [];
  if (!lastLines.length) p.push("Ajoute au moins un dessert à ta commande.");
  if (!val("fn")) p.push("Écris ton prénom.");
  if (!val("ln")) p.push("Écris ton nom.");
  if (!val("commune")) p.push("Choisis ta commune.");
  if (!val("addr")) p.push("Écris ton quartier ou ton adresse.");
  var tel = val("tel").replace(/[\s.\-]/g, "");
  if (!/^(\+213|00213|0)\d{9}$/.test(tel)) p.push("Écris un numéro de téléphone valide, par exemple 0555 12 34 56.");
  return p;
}

function buildMsg(){
  var m = "Bonjour, je voudrais commander chez " + BRAND + " :\n";
  m += lastLines.length ? lastLines.map(function(l){ return "- " + l.n + " × " + l.name; }).join("\n") : "- [ajoute tes desserts]";
  m += "\n\nPrénom : " + (val("fn") || "…");
  m += "\nNom : " + (val("ln") || "…");
  m += "\nCommune : " + (val("commune") || "…");
  m += "\nQuartier / adresse : " + (val("addr") || "…");
  m += "\nTéléphone : " + (val("tel") || "…");
  m += "\n\nMerci de me rappeler pour confirmer ma commande.";
  return m;
}

function updateMsg(lines){
  lastLines = lines || lastLines;
  var m = buildMsg();
  document.getElementById("msg").value = m;
  document.getElementById("send").setAttribute("href", WHATSAPP ? "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(m) : "#commander");
}

function fillCommunes(){
  var sel = document.getElementById("commune");
  var o0 = document.createElement("option"); o0.value = ""; o0.textContent = "Choisis ta commune"; sel.appendChild(o0);
  COMMUNES.forEach(function(c){ var o = document.createElement("option"); o.value = c; o.textContent = c; sel.appendChild(o); });
  sel.addEventListener("change", function(){
    var dl = document.getElementById("quartiers"); dl.innerHTML = "";
    if (sel.value === "Oran") QUARTIERS.forEach(function(q){ var o = document.createElement("option"); o.value = q; dl.appendChild(o); });
    updateMsg();
  });
}

["fn","ln","addr","tel"].forEach(function(id){ document.getElementById(id).addEventListener("input", function(){ updateMsg(); }); });

document.getElementById("send").addEventListener("click", function(e){
  var err = document.getElementById("err"), hint = document.getElementById("copyHint");
  var p = problems();
  if (p.length){ e.preventDefault(); err.hidden = false; err.textContent = p.join(" "); return; }
  err.hidden = true;
  if (!WHATSAPP){
    e.preventDefault();
    var ta = document.getElementById("msg");
    var ok = function(){ hint.textContent = "Message copié. Colle-le dans ta conversation avec nous pour envoyer ta commande."; };
    var fallback = function(){ ta.removeAttribute("readonly"); ta.focus(); ta.select(); ta.setSelectionRange(0, 9999); ta.setAttribute("readonly", ""); hint.textContent = "Copie le message sélectionné et envoie-le-nous."; };
    try { navigator.clipboard.writeText(ta.value).then(ok, fallback); } catch (x) { fallback(); }
  } else {
    hint.textContent = "WhatsApp s'ouvre avec ta commande. Appuie sur envoyer, puis on t'appelle.";
  }
});

fillCommunes();
